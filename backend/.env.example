# RippleGuard backend environment configuration.
# Copy to `.env` and adjust as needed. Never commit a real `.env` file.

# development | production
APP_ENV=development

# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- PLANNED (declared for future phases, not read by any code yet) ---

# Base URL for the OSV (Open Source Vulnerabilities) API.
# Will be consumed by app/vulnerability's OSV provider in a later phase.
OSV_API_BASE_URL=https://api.osv.dev

# --- Production analysis storage (optional) ---
# Leave both unset for local development: the backend falls back to an
# in-process store (see app/services/analysis_store.py). Set both only in
# a stateless/serverless deployment (e.g. Vercel), where the Upstash
# Marketplace integration injects these automatically once connected.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
